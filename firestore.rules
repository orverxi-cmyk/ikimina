rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    

    function isStaff() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.management == true ||
        request.auth.token.accountant == true ||
        request.auth.token.reviewer == true ||
        request.auth.token.auditor == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role in ['admin', 'management', 'accountant', 'reviewer', 'auditor']))
      );
    }

    // Member profiles: Users can update non-financial fields (photoURL, phone, name) on their own profile.
    // Sensitive fields (role, status, accruedInterest) are strictly protected.
    match /users/{userId} {
      allow read: if isSignedIn() || userId == request.auth.uid;
      allow list: if (request.query.limit <= 1) || isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'accruedInterest', 'email', 'joinedAt']);
      allow write: if false; // All other mutations managed via Cloud Functions
    }

    // Contributions: Zero client-side writes.
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via submitContribution / recordContribution / verifyContribution
    }

    // Contribution upload batches (Three-tier migration & payroll batches)
    match /contribution_batches/{batchId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed exclusively via Cloud Functions
    }

    // Loans: Zero client-side writes.
    match /loans/{loanId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via requestLoan / approveLoan / rejectLoan / verifyRepayment
    }
    
    // Repayments: Zero client-side writes.
    match /repayments/{repaymentId} {
      allow read: if isSignedIn() && (isStaff() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isStaff() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via recordRepayment / verifyRepayment
    }

    // Audit logs: Strictly immutable and created exclusively by Cloud Functions
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // System financial policy, footer and platform branding settings (Public read for unauthenticated views).
    // Note: settings/email contains sensitive SMTP secrets and is strictly blocked from direct client reads.
    match /settings/{docId} {
      allow read: if docId != 'email';
      allow write: if false;
    }

    // Ledger entries: Strictly immutable and server-controlled
    match /interest_distributions/{distId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Interest distribution proposals: Managed via Cloud Functions, readable by signed-in users
    match /interest_distribution_requests/{requestId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Operating expenses: Managed exclusively via Cloud Functions
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Final payouts (member exit): Initiated by Accountant, approved by Super Admin via Cloud Functions
    match /final_payouts/{payoutId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Account deletion requests: Managed via Cloud Functions with client fallback, readable by signed-in users
    match /account_deletion_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && request.resource.data.status == 'cancelled') ||
        isStaff()
      );
      allow delete: if isStaff();
    }
  }
}
