
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isManagement() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.management == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'management' || getUserData().role == 'admin'))
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }

    match /settings/bootstrap {
      allow read, write: if !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    match /users/{userId} {
      allow read: if isSignedIn() || userId == request.auth.uid;
      allow list: if (request.query.limit <= 1) || isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'accruedInterest']));
    }

    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /loans/{loanId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }
    
    match /repayments/{repaymentId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /audit_logs/{logId} {
      allow read: if isManagement();
      allow create: if isSignedIn(); 
    }

    match /settings/financials {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
