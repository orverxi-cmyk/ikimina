rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers for professional security evaluation
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Checks for either Custom Claims (high performance) or Firestore Role (fallback/initial)
    function isManagement() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.management == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'management' || getUserData().role == 'admin'))
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }

    // Initial system bootstrap logic
    match /settings/bootstrap {
      allow read, write: if !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    // User profile permissions
    match /users/{userId} {
      // Allow read if signed in, or if checking own profile by UID
      allow read: if isSignedIn() || userId == request.auth.uid;
      
      // ALLOW UNRECOGNIZED USERS TO QUERY BY EMAIL (LIMIT 1) FOR LOGIN/ACTIVATION
      // This is secure because it only allows finding if an email exists without exposing the UID or other fields easily.
      allow list: if (request.query.limit <= 1) || isSignedIn();
      
      // Allow management to write roles, users can only write non-critical fields
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'accruedInterest']));
    }

    // Financial transaction permissions
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /loans/{loanId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }
    
    match /repayments/{repaymentId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    // System audit and financial logs
    match /audit_logs/{logId} {
      allow read: if isManagement();
      allow create: if isSignedIn(); 
    }

    match /settings/financials {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}