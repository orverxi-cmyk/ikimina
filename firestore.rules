
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && getUserData().role == 'admin'; }
    function isManagement() { return signedIn() && (getUserData().role == 'admin' || getUserData().role == 'management'); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isOwner(userId);
    }

    match /contributions/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /loans/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isManagement();
      allow delete: if isAdmin();
    }
  }
}
