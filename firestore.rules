rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin() { return signedIn() && getUserData(request.auth.uid).role == 'admin'; }
    function isManagement() { return signedIn() && (getUserData(request.auth.uid).role == 'admin' || getUserData(request.auth.uid).role == 'management'); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }

    match /settings/bootstrap {
      // Publicly readable so the app can check if it's initialized
      allow read: if true;
      allow write: if signedIn();
    }

    match /users/{userId} {
      // Allow unauthenticated lookup by email for login/activation check
      // We allow list if the query is limited to 1 result.
      allow list: if (request.query.limit <= 1) || signedIn();
      
      // Allow individual document reads if signed in and authorized
      allow get: if signedIn() && (isOwner(userId) || isManagement());

      // Allow creation if Admin OR if the bootstrap setting doesn't exist yet (Emergency First Admin)
      allow create: if isAdmin() || (signedIn() && !exists(/databases/$(database)/documents/settings/bootstrap));
      
      // Allow updates for profile management
      allow update: if isAdmin() || (signedIn() && isOwner(userId) && (resource.data.status == 'pending' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'name', 'status', 'activatedAt', 'amortizationSchedule'])));
      
      allow delete: if isAdmin();
    }

    match /contributions/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /loans/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isManagement();
      allow delete: if isAdmin();
    }
    
    match /repayments/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isManagement();
      allow delete: if isAdmin();
    }
  }
}