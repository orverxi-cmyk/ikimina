rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isManagement() {
      return isSignedIn() && (
        request.auth.token.admin == true || 
        request.auth.token.management == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (getUserData().role == 'management' || getUserData().role == 'admin'))
      );
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         getUserData().role == 'admin')
      );
    }

    // Member profiles: Users can update non-financial fields (photoURL, phone, name) on their own profile.
    // Sensitive fields (role, status, accruedInterest) are strictly protected.
    match /users/{userId} {
      allow read: if isSignedIn() || userId == request.auth.uid;
      allow list: if (request.query.limit <= 1) || isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'accruedInterest', 'email', 'joinedAt']);
      allow write: if false; // All other mutations managed via Cloud Functions
    }

    // Contributions: Zero client-side writes.
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via submitContribution / recordContribution / verifyContribution
    }

    // Loans: Zero client-side writes.
    match /loans/{loanId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via requestLoan / approveLoan / rejectLoan / verifyRepayment
    }
    
    // Repayments: Zero client-side writes.
    match /repayments/{repaymentId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow write: if false; // Managed via recordRepayment / verifyRepayment
    }

    // Audit logs: Strictly immutable and created exclusively by Cloud Functions
    match /audit_logs/{logId} {
      allow read: if isManagement();
      allow write: if false;
    }

    // System financial policy settings: Read via getSystemSettings Cloud Function
    match /settings/financials {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Ledger entries: Strictly immutable and server-controlled
    match /interest_distributions/{distId} {
      allow read: if isManagement();
      allow write: if false;
    }

    // Operating expenses: Managed exclusively via Cloud Functions
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
