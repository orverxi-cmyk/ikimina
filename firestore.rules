rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helpers for professional security evaluation
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isManagement() {
      return isSignedIn() && (getUserData().role == 'management' || getUserData().role == 'admin');
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    // Initial system bootstrap logic
    match /settings/bootstrap {
      allow read, write: if !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    // User profile permissions
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'accruedInterest']));
    }

    // Financial transaction permissions
    match /contributions/{contributionId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    match /loans/{loanId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }
    
    match /repayments/{repaymentId} {
      allow read: if isSignedIn() && (isManagement() || resource.data.memberId == request.auth.uid);
      allow list: if isSignedIn() && (isManagement() || request.query.filters.memberId == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isManagement();
    }

    // System audit and financial logs
    match /audit_logs/{logId} {
      allow read: if isManagement();
      allow create: if isSignedIn(); // Allow creation for audit trail tracking
    }

    match /settings/financials {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}