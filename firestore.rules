
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin() { return signedIn() && getUserData(request.auth.uid).role == 'admin'; }
    function isManagement() { return signedIn() && (getUserData(request.auth.uid).role == 'admin' || getUserData(request.auth.uid).role == 'management'); }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    
    // Allow users to update their own document if the email matches their auth token email.
    // This is crucial for the "pending" to "active" transition where UID changes.
    function isEmailOwner(email) { return signedIn() && request.auth.token.email == email; }

    match /settings/bootstrap {
      allow read: if true;
      allow write: if signedIn() || !exists(/databases/$(database)/documents/settings/bootstrap);
    }

    match /users/{userId} {
      // Allow unauthenticated lookup by email for the login screen's "Is this email registered?" check.
      // Limited to query limit 1 for security.
      allow list: if (request.query.limit <= 1);
      
      // Allow get for everyone to verify user existence during activation/sign-in flows.
      allow get: if signedIn() || (!signedIn() && exists(/databases/$(database)/documents/users/$(userId)));

      // Creation is reserved for Admins or the initial Bootstrap process
      allow create: if isAdmin() || (signedIn() && !exists(/databases/$(database)/documents/settings/bootstrap));
      
      // Strict update rules for profile activation and management
      allow update: if isAdmin() || 
                    (signedIn() && (isOwner(userId) || isEmailOwner(resource.data.email)));
      
      allow delete: if isAdmin();
    }

    match /contributions/{id} {
      allow list: if isManagement() || (signedIn() && request.query.filters.hasAll([['memberId', '==', request.auth.uid]]));
      allow get: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /loans/{id} {
      allow list: if isManagement() || (signedIn() && request.query.filters.hasAll([['memberId', '==', request.auth.uid]]));
      allow get: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isManagement() || (signedIn() && isOwner(resource.data.memberId));
      allow delete: if isAdmin();
    }
    
    match /repayments/{id} {
      allow read: if isManagement() || (signedIn() && resource.data.memberId == request.auth.uid);
      allow create: if signedIn();
      allow update: if isManagement();
      allow delete: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }
  }
}
