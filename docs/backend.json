{
  "entities": {
    "user": {
      "title": "User",
      "description": "A user of the application.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "The user's name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "type": {
          "type": "string",
          "description": "The user's role.",
          "enum": ["user", "admin"]
        }
      },
      "required": ["name", "email"]
    },
    "payout": {
      "title": "Payout",
      "description": "A payout record for a user.",
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "song": {
      "title": "Song",
      "type": "object",
      "properties": {
        "singerId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["singerId", "title", "url"]
    },
    "instrumental": {
      "title": "Instrumental",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "genre": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["creatorId", "title", "url"]
    },
    "timelinePost": {
      "title": "Timeline Post",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["authorId", "content"]
    },
    "teel": {
      "title": "Teel",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["creatorId", "url"]
    },
    "advertisement": {
      "title": "Advertisement",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string"
        },
        "campaignName": {
          "type": "string"
        },
        "budget": {
          "type": "number"
        }
      },
      "required": ["creatorId", "campaignName", "budget"]
    },
    "story": {
      "title": "Story",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "url", "expiresAt"]
    },
    "playlist": {
      "title": "Playlist",
      "type": "object",
      "properties": {
        "creatorId": {
          "type": "string"
        },
        "isPublic": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["creatorId", "isPublic", "name"]
    },
    "chatRoom": {
      "title": "Chat Room",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["participantIds"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "type": "object",
      "properties": {
        "senderId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["senderId", "text"]
    },
    "supportTicket": {
      "title": "Support Ticket",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["userId", "subject"]
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/user"
      },
      "description": "User profile information."
    },
    "/users/{userId}/payouts/{payoutId}": {
      "schema": {
        "$ref": "#/entities/payout"
      },
      "description": "User payout records."
    },
    "/songs/{songId}": {
      "schema": {
        "$ref": "#/entities/song"
      },
      "description": "Songs created by users."
    },
    "/instrumentals-new/{instrumentalId}": {
      "schema": {
        "$ref": "#/entities/instrumental"
      },
      "description": "Instrumentals uploaded by users."
    },
    "/timeline_posts/{postId}": {
      "schema": {
        "$ref": "#/entities/timelinePost"
      },
      "description": "Posts on the main timeline."
    },
    "/teels/{teelId}": {
      "schema": {
        "$ref": "#/entities/teel"
      },
      "description": "Short video or photo content."
    },
    "/advertisements/{adId}": {
      "schema": {
        "$ref": "#/entities/advertisement"
      },
      "description": "Ad campaigns."
    },
    "/stories/{storyId}": {
      "schema": {
        "$ref": "#/entities/story"
      },
      "description": "Temporary stories from users."
    },
    "/playlists/{playlistId}": {
      "schema": {
        "$ref": "#/entities/playlist"
      },
      "description": "User-created playlists of songs."
    },
    "/chatRooms/{roomId}": {
      "schema": {
        "$ref": "#/entities/chatRoom"
      },
      "description": "Chat rooms between users."
    },
    "/chatRooms/{roomId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/chatMessage"
      },
      "description": "Messages within a chat room."
    },
    "/supportTickets/{ticketId}": {
      "schema": {
        "$ref": "#/entities/supportTicket"
      },
      "description": "Support tickets submitted by users."
    }
  }
}
