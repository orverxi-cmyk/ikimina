
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A member of the SCDT Tontine.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "management", "member"],
          "description": "Admin (Full control), Management (Loan approvals/Reports), Member (Own data/Requests)"
        },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role"]
    },
    "contribution": {
      "title": "Contribution",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string", "description": "e.g., 'October 2023'" },
        "date": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" }
      },
      "required": ["memberId", "amount", "period", "date"]
    },
    "loan": {
      "title": "Loan",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["requested", "approved", "rejected", "completed"] },
        "requestDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "penaltyAmount": { "type": "number" },
        "balance": { "type": "number" },
        "description": { "type": "string" }
      },
      "required": ["memberId", "amount", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/user" } },
    "/contributions/{contributionId}": { "schema": { "$ref": "#/entities/contribution" } },
    "/loans/{loanId}": { "schema": { "$ref": "#/entities/loan" } }
  }
}
