
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A member of the SCDT Tontine.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "management", "member"],
          "description": "Admin (Full control), Management (Loan approvals/Reports), Member (Own data/Requests)"
        },
        "joinedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "active"] },
        "otp": { "type": "string", "description": "Temporary activation code" }
      },
      "required": ["name", "email", "role"]
    },
    "contribution": {
      "title": "Contribution",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string", "description": "e.g., 'October 2023'" },
        "date": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" }
      },
      "required": ["memberId", "amount", "period", "date"]
    },
    "loan": {
      "title": "Loan",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "interestType": { "type": "string", "enum": ["immediate", "afterward"] },
        "status": { "type": "string", "enum": ["requested", "approved", "rejected", "completed"] },
        "requestDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "penaltyRate": { "type": "number", "description": "Daily penalty rate as a decimal (e.g. 0.0015 for 0.15%)" },
        "penaltyAmount": { "type": "number" },
        "balance": { "type": "number" },
        "description": { "type": "string" },
        "checkUrl": { "type": "string", "description": "URL to the check image uploaded on approval" }
      },
      "required": ["memberId", "amount", "status"]
    },
    "repayment": {
      "title": "Repayment",
      "type": "object",
      "properties": {
        "loanId": { "type": "string" },
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "proofUrl": { "type": "string", "description": "URL to the proof of payment image" },
        "status": { "type": "string", "enum": ["pending", "verified"] }
      },
      "required": ["loanId", "memberId", "amount", "date", "proofUrl"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/user" } },
    "/contributions/{contributionId}": { "schema": { "$ref": "#/entities/contribution" } },
    "/loans/{loanId}": { "schema": { "$ref": "#/entities/loan" } },
    "/repayments/{repaymentId}": { "schema": { "$ref": "#/entities/repayment" } }
  }
}
