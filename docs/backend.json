
{
  "entities": {
    "user": {
      "title": "User",
      "description": "A member of the Ikimina App.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "management", "member"],
          "description": "Admin (Full control), Management (Loan approvals/Reports), Member (Own data/Requests)"
        },
        "joinedAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "active"] },
        "activatedAt": { "type": "string", "format": "date-time" },
        "accruedInterest": { "type": "number", "default": 0 },
        "amortizationSchedule": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dueDate": { "type": "string", "format": "date-time" },
              "amount": { "type": "number" },
              "status": { "type": "string", "enum": ["pending", "paid", "overdue"] },
              "proofUrl": { "type": "string" },
              "paidAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "required": ["name", "email", "role"]
    },
    "contribution": {
      "title": "Contribution",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "period": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "recordedBy": { "type": "string" }
      },
      "required": ["memberId", "amount", "period", "date"]
    },
    "loan": {
      "title": "Loan",
      "type": "object",
      "properties": {
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "interestAmount": { "type": "number" },
        "interestRate": { "type": "number", "description": "Monthly interest rate as a decimal" },
        "interestType": { "type": "string", "enum": ["immediate", "afterward"] },
        "status": { "type": "string", "enum": ["requested", "approved", "rejected", "completed"] },
        "requestDate": { "type": "string", "format": "date-time" },
        "startDate": { "type": "string", "format": "date-time" },
        "dueDate": { "type": "string", "format": "date-time" },
        "penaltyRate": { "type": "number" },
        "balance": { "type": "number" },
        "durationMonths": { "type": "number" },
        "description": { "type": "string" },
        "checkUrl": { "type": "string" },
        "amortization": { "type": "array" }
      },
      "required": ["memberId", "amount", "status"]
    },
    "repayment": {
      "title": "Repayment",
      "type": "object",
      "properties": {
        "loanId": { "type": "string" },
        "memberId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "proofUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified"] }
      },
      "required": ["loanId", "memberId", "amount", "date", "proofUrl"]
    },
    "audit_log": {
      "title": "Audit Log",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "justification": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "details": { "type": "object" }
      },
      "required": ["adminId", "action", "justification", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/user" } },
    "/contributions/{contributionId}": { "schema": { "$ref": "#/entities/contribution" } },
    "/loans/{loanId}": { "schema": { "$ref": "#/entities/loan" } },
    "/repayments/{repaymentId}": { "schema": { "$ref": "#/entities/repayment" } },
    "/audit_logs/{logId}": { "schema": { "$ref": "#/entities/audit_log" } }
  }
}
