
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read;
    }

    match /avatars/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /loan_checks/{loanId}/{allPaths=**} {
      allow write: if request.auth != null; 
    }

    match /repayment_proofs/{memberId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    match /contribution_proofs/{memberId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    match /loan_management_approvals/{memberId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == memberId;
    }

    match /expense_receipts/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /final_payout_documents/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
