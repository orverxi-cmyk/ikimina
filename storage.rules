rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all files by default
    match /{allPaths=**} {
      allow read;
    }

    // Allow authenticated users to write to their own avatar folder
    match /avatars/{userId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Add more specific rules for other paths as needed
    // e.g., for instrumentals, songs, etc.
    match /instrumentals-new/{userId}/{instrumentalId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /songs/{userId}/{songId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /teels/{userId}/{teelId}/{allPaths=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /timeline_media/{userId}/{postId}/{allPaths=**} {
        allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}